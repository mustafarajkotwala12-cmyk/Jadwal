<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             xmlns:ctrl="using:Jadwal.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Jadwal.UI.Views.TimetableView"
             x:DataType="vm:TimetableViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24">

            <!-- HEADER & DAY SELECTOR TABS -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <!-- Day Selector Buttons with Kanz-al-Lulu Arabic Typography -->
                    <ItemsControl ItemsSource="{Binding DayTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DayTabViewModel">
                                <Button Command="{Binding $parent[UserControl].((vm:TimetableViewModel)DataContext).SelectDayTabCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="12,6" CornerRadius="10"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <Button.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </Button.Transitions>
                                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ArabicName}"
                                                   FontFamily="{StaticResource ArabicCalligraphyFont}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding EnglishName}"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Search box with Arabic Font Support -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText}"
                         FontFamily="{StaticResource ArabicCalligraphyFont}"
                         PlaceholderText="Search subject, ustaadh, room..."
                         Width="240" CornerRadius="8"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- SELECTED DAY BANNER -->
            <Border CornerRadius="16"
                    Background="{DynamicResource BannerGradientBrush}"
                    Padding="22,16"
                    BoxShadow="0 6 20 0 #200B4F39">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding DayArabicTitle}"
                                   FontFamily="{StaticResource ArabicCalligraphyFont}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding DayTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#F0F8F5" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DaySubtitle}"
                               FontSize="12" Foreground="#D5E8DF"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ROW 1: MORNING SESSIONS -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Row1Title}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource BronzeBrush}"
                           Margin="4,0,0,0" />

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Row1Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:ClassCardItemViewModel">
                                <ctrl:ClassCardControl />
                            </DataTemplate>
                            <DataTemplate DataType="vm:BreakPillItemViewModel">
                                <ctrl:VerticalBreakPillControl />
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- ROW 2: AFTERNOON SESSIONS -->
            <StackPanel Spacing="10" IsVisible="{Binding !IsEmptyDay}">
                <TextBlock Text="{Binding Row2Title}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource BronzeBrush}"
                           Margin="4,0,0,0" />

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Row2Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:ClassCardItemViewModel">
                                <ctrl:ClassCardControl />
                            </DataTemplate>
                            <DataTemplate DataType="vm:BreakPillItemViewModel">
                                <ctrl:VerticalBreakPillControl />
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- EMPTY DAY NOTICE -->
            <Border IsVisible="{Binding IsEmptyDay}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="40" HorizontalAlignment="Center" Margin="0,40,0,0">
                <TextBlock Text="No classes scheduled for this day."
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
