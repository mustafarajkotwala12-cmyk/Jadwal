<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="Jadwal.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="24" MaxWidth="760" HorizontalAlignment="Left">

            <!-- HEADER -->
            <StackPanel Spacing="2">
                <TextBlock Text="Settings &amp; Preferences" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BronzeBrush}" />
                <TextBlock Text="Customize your Fatimid theme, configure portal credentials, and view system credits" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- STATUS BANNER -->
            <Border IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource GoldSoftBrush}"
                    BorderBrush="{DynamicResource GoldBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,10">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- CARD 1: APPEARANCE & THEME (FATIMID ISLAMIC THEME) -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1.5" CornerRadius="14"
                    Padding="20" BoxShadow="0 4 14 0 #10000000">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="14">
                    <TextBlock Text="Appearance &amp; Theme" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BronzeBrush}" />
                    <TextBlock Text="Select your visual experience. Experience the authentic Light Fatimid aesthetic inspired by classical illuminated manuscripts."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <!-- Light Fatimid Theme Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="Light"
                                Margin="0,0,8,0" Padding="16,14"
                                CornerRadius="12"
                                HorizontalAlignment="Stretch"
                                Background="{Binding IsLightTheme, Converter={x:Static ObjectConverters.IsNull}}"
                                BorderBrush="{DynamicResource EmeraldBrush}"
                                BorderThickness="1.5">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="☀️" FontSize="16" />
                                    <TextBlock Text="Fatimid Ivory (Light)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Warm manuscript parchment &amp; regal emerald" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <Border IsVisible="{Binding IsLightTheme}"
                                        Background="{DynamicResource EmeraldSoftBrush}"
                                        CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="✓ Active Theme" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource EmeraldBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Dark Fatimid Theme Button -->
                        <Button Grid.Column="1"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="Dark"
                                Margin="8,0,0,0" Padding="16,14"
                                CornerRadius="12"
                                HorizontalAlignment="Stretch"
                                BorderBrush="{DynamicResource BronzeBrush}"
                                BorderThickness="1.5">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="🌙" FontSize="16" />
                                    <TextBlock Text="Fatimid Obsidian (Dark)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Deep emerald slate &amp; luminous gold" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <Border IsVisible="{Binding IsDarkTheme}"
                                        Background="{DynamicResource BronzeSoftBrush}"
                                        CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="✓ Active Theme" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BronzeBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CARD 2: ITS CREDENTIALS & SCHEDULE SYNC -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1.5" CornerRadius="14"
                    Padding="20" BoxShadow="0 4 14 0 #10000000">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="16">
                    <TextBlock Text="ITS Portal Credentials &amp; Timetable Sync" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BronzeBrush}" />
                    <TextBlock Text="Credentials are securely stored using native OS hardware encryption (Apple Keychain on macOS, DPAPI on Windows)."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- CREDENTIAL STATUS BADGE -->
                    <Border IsVisible="{Binding IsCredentialsSaved}"
                            Background="#E6F4EA" BorderBrush="#34A853"
                            BorderThickness="1.2" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="✓ Credentials Stored &amp; Encrypted" FontWeight="Bold" FontSize="13" Foreground="#137333" />
                                        <TextBlock Text="{Binding StoredItsId, StringFormat='(ITS: {0})'}" FontWeight="SemiBold" FontSize="13" Foreground="#137333" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StoredCredentialStatusText}" FontSize="11" Foreground="#3C4043" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Remove Credentials"
                                    Command="{Binding ClearCredentialsCommand}"
                                    Background="#FCE8E6" Foreground="#C5221F"
                                    BorderBrush="#F28B82" BorderThickness="1"
                                    CornerRadius="6" FontSize="11" FontWeight="SemiBold"
                                    Padding="10,5" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding !IsCredentialsSaved}"
                            Background="#FEF7E0" BorderBrush="#F9AB00"
                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="ℹ️" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="No credentials currently stored in OS vault. Enter your ITS ID and password below and click Save."
                                       FontSize="11" Foreground="#7A4B04" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- INPUT FIELDS -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ITS ID" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Text="{Binding ItsId}" PlaceholderText="e.g. 30300000" CornerRadius="8" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Enter your ITS password" CornerRadius="8" />
                    </StackPanel>

                    <!-- ACTIONS -->
                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Save Credentials"
                                Command="{Binding SaveCredentialsCommand}"
                                Padding="16,9" CornerRadius="8" FontWeight="SemiBold" Margin="0,0,10,10" />

                        <Button Content="🔄 Sync Jamia Timetable"
                                Command="{Binding SyncJamiaScheduleCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Background="{DynamicResource EmeraldBrush}" Foreground="White"
                                Padding="16,9" CornerRadius="8" FontWeight="Bold" Margin="0,0,10,10"
                                ToolTip.Tip="Syncs timetable directly using saved session without opening a browser." />

                        <Button Content="🔑 Re-Authenticate Portal"
                                Command="{Binding ReauthenticatePortalCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Background="{DynamicResource BronzeSoftBrush}" Foreground="{DynamicResource BronzeBrush}"
                                Padding="16,9" CornerRadius="8" FontWeight="SemiBold" Margin="0,0,10,10"
                                ToolTip.Tip="Opens login window to re-authenticate or switch ITS account." />

                        <Button Content="📂 Import Timetable (.json / .xlsx)"
                                Command="{Binding ImportTimetableFileCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Background="{DynamicResource BronzeSoftBrush}" Foreground="{DynamicResource BronzeBrush}"
                                Padding="16,9" CornerRadius="8" FontWeight="SemiBold" Margin="0,0,10,10" />
                    </WrapPanel>

                    <!-- AUTO SYNC INTERVAL -->
                    <Border Background="#0A000000" CornerRadius="10" Padding="14,10" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="🔁 Auto Sync Interval" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Background sync with Jamia API. Detects timetable changes automatically."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                                <ComboBox SelectedItem="{Binding SyncIntervalMinutes}"
                                          ItemsSource="{Binding SyncIntervalOptions}"
                                          MinWidth="80" CornerRadius="8"
                                          ToolTip.Tip="Choose how often the app syncs with the Jamia portal (3–10 minutes)" />
                                <TextBlock Text="min" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD 3: LEGACY DATA MIGRATION -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1.5" CornerRadius="14"
                    Padding="20" BoxShadow="0 4 14 0 #10000000">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="14">
                    <TextBlock Text="Legacy Data Migration" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BronzeBrush}" />
                    <TextBlock Text="Import tasks, timetable snapshots, and changes from previous Swift / Python versions of JameaHelper / Jadwal. Automated backups are created before migration."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <Button Content="📦 Import from Legacy Stores"
                            Command="{Binding RunLegacyMigrationCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            Padding="16,8" CornerRadius="8" FontWeight="SemiBold" />

                    <TextBlock Text="{Binding MigrationReport}"
                               IsVisible="{Binding MigrationReport, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Foreground="{DynamicResource EmeraldBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- CARD 4: CREDITS & ABOUT SECTION -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1.5" CornerRadius="14"
                    Padding="22" BoxShadow="0 4 14 0 #10000000">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Ornamental Islamic Star Motif Badge -->
                    <Border Grid.Column="0" Width="64" Height="64"
                            CornerRadius="16"
                            Background="{DynamicResource BannerGradientBrush}"
                            VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="📖" FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Details -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding AppName}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border Background="{DynamicResource BronzeSoftBrush}"
                                    CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource BronzeBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding AppSubtitle}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- Developer Credit -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <TextBlock Text="Designed &amp; Developed by:"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding DeveloperName}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource EmeraldBrush}" />
                        </StackPanel>

                        <!-- Platform info -->
                        <TextBlock Text="Engine: .NET 10 LTS • Avalonia UI • Cross-Platform Native Architecture (macOS &amp; Windows)"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
