<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             xmlns:views="using:Jadwal.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="Jadwal.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Button.navBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.navBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="240,*">
        <!-- LEFT SIDEBAR / MENU CARD -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarGradientBrush}"
                Padding="16,20">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- BRAND HEADER -->
                <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📖" FontSize="22" VerticalAlignment="Center" />
                        <TextBlock Text="Jadwal"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource GoldBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="جدول الحصص"
                               FontFamily="{StaticResource ArabicCalligraphyFont}"
                               FontSize="18"
                               Foreground="{DynamicResource SidebarTextMutedBrush}"
                               Margin="6,2,0,0" />
                </StackPanel>

                <!-- NAVIGATION BUTTONS -->
                <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Top">
                    <!-- Today -->
                    <Button Classes="navBtn" Command="{Binding NavigateToTodayCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📅" FontSize="16" />
                            <TextBlock Text="Today" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Calendar -->
                    <Button Classes="navBtn" Command="{Binding NavigateToCalendarCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🌙" FontSize="16" />
                            <TextBlock Text="Calendar" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Timetable -->
                    <Button Classes="navBtn" Command="{Binding NavigateToTimetableCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🗓️" FontSize="16" />
                            <TextBlock Text="Timetable" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Tasks -->
                    <Button Classes="navBtn" Command="{Binding NavigateToTasksCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📝" FontSize="16" />
                            <TextBlock Text="Tasks" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Classes="navBtn" Command="{Binding NavigateToSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="⚙️" FontSize="16" />
                            <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- DATE AND TIME IN BIG LETTERS (MENU CARD BOTTOM) -->
                <Border Grid.Row="2"
                        Background="#1A000000"
                        BorderBrush="{DynamicResource GoldSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,14"
                        Margin="0,12,0,0"
                        BoxShadow="0 4 12 0 #20000000">
                    <StackPanel Spacing="10">

                        <!-- DATE SECTION (BIG LETTERS) -->
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <!-- Arabic Weekday Calligraphy -->
                            <TextBlock Text="{Binding BigDateArabicDay}"
                                       FontFamily="{StaticResource ArabicCalligraphyFont}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource GoldBrush}"
                                       HorizontalAlignment="Center" />

                            <!-- English Day (Big Bold) -->
                            <TextBlock Text="{Binding BigDateDay}"
                                       FontSize="18" FontWeight="ExtraBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" />

                            <!-- Gregorian Date -->
                            <TextBlock Text="{Binding BigDateEnglish}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E0EDE7"
                                       HorizontalAlignment="Center" />

                            <!-- Hijri Date -->
                            <Border Background="#20C5A880"
                                    BorderBrush="{DynamicResource GoldSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,3"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BigDateHijri}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- SLEEK DIVIDER -->
                        <Rectangle Height="1" Fill="#20FFFFFF" Margin="4,0" />

                        <!-- TIME SECTION (BIG LETTERS) -->
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BigTimeDigits}"
                                           FontFamily="Courier New, monospace"
                                           FontSize="32" FontWeight="Heavy"
                                           Foreground="White"
                                           VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding BigTimeAmPm}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" />
                            </StackPanel>

                            <!-- Live Time Indicator -->
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" />
                                <TextBlock Text="Live Time" FontSize="10" Foreground="{DynamicResource SidebarTextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA WITH SMOOTH FLUID TRANSITIONS -->
        <Border Grid.Column="1" Background="{DynamicResource PageBackgroundBrush}">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <TransitioningContentControl Content="{Binding CurrentPage}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.25" />
                </TransitioningContentControl.PageTransition>
                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="vm:TodayViewModel">
                        <views:TodayView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:CalendarViewModel">
                        <views:CalendarView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:TimetableViewModel">
                        <views:TimetableView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:TasksViewModel">
                        <views:TasksView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <views:SettingsView />
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
            </TransitioningContentControl>
        </Border>
    </Grid>
</UserControl>
