<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             xmlns:views="using:Jadwal.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="Jadwal.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid ColumnDefinitions="220,*">
        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarGradientBrush}"
                Padding="16,24">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- BRAND HEADER -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📖" FontSize="22" VerticalAlignment="Center" />
                        <TextBlock Text="Jadwal"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource GoldBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="جدول الحصص"
                               FontFamily="{StaticResource ArabicCalligraphyFont}"
                               FontSize="18" Foreground="#94A3B8"
                               Margin="30,0,0,0" />
                </StackPanel>

                <!-- NAVIGATION BUTTONS -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <!-- Today -->
                    <Button Command="{Binding NavigateToTodayCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="14,10" CornerRadius="10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📅" FontSize="16" />
                            <TextBlock Text="Today" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <!-- Timetable -->
                    <Button Command="{Binding NavigateToTimetableCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="14,10" CornerRadius="10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🗓️" FontSize="16" />
                            <TextBlock Text="Timetable" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <!-- Tasks -->
                    <Button Command="{Binding NavigateToTasksCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="14,10" CornerRadius="10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📝" FontSize="16" />
                            <TextBlock Text="Tasks" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Command="{Binding NavigateToSettingsCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="14,10" CornerRadius="10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="⚙️" FontSize="16" />
                            <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- FOOTER -->
                <Border Grid.Row="2" Background="#15FFFFFF" CornerRadius="8" Padding="10,6">
                    <TextBlock Text=".NET 10 • Avalonia UI" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:TodayViewModel">
                    <views:TodayView />
                </DataTemplate>
                <DataTemplate DataType="vm:TimetableViewModel">
                    <views:TimetableView />
                </DataTemplate>
                <DataTemplate DataType="vm:TasksViewModel">
                    <views:TasksView />
                </DataTemplate>
                <DataTemplate DataType="vm:SettingsViewModel">
                    <views:SettingsView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </Grid>
</UserControl>
