<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             xmlns:ctrl="using:Jadwal.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Jadwal.UI.Views.TodayView"
             x:DataType="vm:TodayViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="24">

            <!-- HERO BANNER: DATE & TIME (FATIMID ILLUMINATED STYLE) -->
            <Border CornerRadius="18"
                    Background="{DynamicResource BannerGradientBrush}"
                    Padding="26,20"
                    BoxShadow="0 8 24 0 #200B4F39">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Left: Arabic Weekday, English Date, Subtitle -->
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ArabicWeekday}"
                                   FontFamily="{StaticResource ArabicCalligraphyFont}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding EnglishDate}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#F0F8F5" />
                        <TextBlock Text="{Binding DaySubtitle}"
                                   FontSize="12" Foreground="#D5E8DF"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Right: Digital Clock & Status Pill -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                        <Border Background="#25FFFFFF" CornerRadius="10" Padding="12,6" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrentTimeString}"
                                       FontFamily="Courier New, monospace"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" />
                        </Border>
                        <Border Background="{DynamicResource EmeraldBrush}" CornerRadius="12" Padding="12,6">
                            <TextBlock Text="{Binding ActiveStatusDescription}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CHANGES ALERT BANNER (SHOWN WHEN SCHEDULE HAS DISCREPANCIES) -->
            <Border IsVisible="{Binding HasChanges}"
                    Background="#FFFBEB"
                    BorderBrush="#F59E0B"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Timetable Changes Detected" FontWeight="Bold" FontSize="13" Foreground="#92400E" />
                        <TextBlock Text="{Binding ChangesSummary}" FontSize="12" Foreground="#B45309" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Acknowledge"
                            Command="{Binding AcknowledgeChangesCommand}"
                            Background="#F59E0B" Foreground="White"
                            FontWeight="SemiBold" CornerRadius="8"
                            Padding="12,6" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 3-ROW TIMETABLE LAYOUT -->
            <StackPanel Spacing="6" IsVisible="{Binding !IsEmptyDay}">
                <!-- ROW 1: 3 SUBJECT CARDS + SMALL PHYSICAL EDUCATION SLOT (HIDDEN ON FRIDAY) -->
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Academic Subject Cards -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Row1Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ClassCardItemViewModel">
                                <ctrl:ClassCardControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Small Physical Education Slot (Shown Mon-Thu, Removed on Friday) -->
                    <ContentControl Grid.Column="1"
                                    IsVisible="{Binding HasPhysicalEducation}"
                                    Content="{Binding PhysicalEducationCard}"
                                    Width="155">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="vm:ClassCardItemViewModel">
                                <ctrl:PhysicalEducationCardControl />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>

                <!-- BREAK 1: HORIZONTAL FULL-WIDTH STRIP (RECESS BREAK) -->
                <Panel IsVisible="{Binding HasBreak1}">
                    <ctrl:HorizontalBreakBarControl DataContext="{Binding Break1}" />
                </Panel>

                <!-- ROW 2: 3 SUBJECT CARDS -->
                <ItemsControl ItemsSource="{Binding Row2Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ClassCardItemViewModel">
                            <ctrl:ClassCardControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- BREAK 2: HORIZONTAL FULL-WIDTH STRIP (LUNCH & NAMAZ BREAK) -->
                <Panel IsVisible="{Binding HasBreak2}">
                    <ctrl:HorizontalBreakBarControl DataContext="{Binding Break2}" />
                </Panel>

                <!-- ROW 3: 3 SUBJECT CARDS -->
                <ItemsControl ItemsSource="{Binding Row3Cards}"
                              IsVisible="{Binding HasRow3}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ClassCardItemViewModel">
                            <ctrl:ClassCardControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- EMPTY STATE NOTICE -->
            <Border IsVisible="{Binding IsEmptyDay}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="40" HorizontalAlignment="Center" Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="📅" FontSize="36" HorizontalAlignment="Center" />
                    <TextBlock Text="No classes scheduled for today."
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sync with Jamia Portal or import a timetable file in Settings to load your schedule."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
