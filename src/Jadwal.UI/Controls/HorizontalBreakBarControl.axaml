<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="52"
             x:Class="Jadwal.UI.Controls.HorizontalBreakBarControl"
             x:DataType="vm:BreakBarViewModel">

    <Border CornerRadius="14"
            BorderThickness="1"
            BorderBrush="{DynamicResource CardBorderBrush}"
            Background="{DynamicResource GoldSoftBrush}"
            BoxShadow="0 2 10 0 #0D000000"
            Padding="16,10"
            Margin="0,8">
        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
        </Border.Transitions>

        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- Left: Break Icon & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border CornerRadius="8" Background="#18C29447" Padding="8,4">
                    <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource BronzeBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Center: Namaaz / Activity Note -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NamaazNote}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: Time Range & Duration Pill -->
            <Border Grid.Column="2"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding TimeRange}"
                               FontSize="11" FontWeight="Bold"
                               FontFamily="Courier New, monospace"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding Duration}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource BronzeBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
