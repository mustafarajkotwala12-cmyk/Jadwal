<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="42"
             x:Class="Jadwal.UI.Controls.HorizontalBreakBarControl"
             x:DataType="vm:BreakBarViewModel">

    <Border CornerRadius="{Binding BarCornerRadius}"
            BorderThickness="1"
            BorderBrush="{DynamicResource CardBorderBrush}"
            Background="{DynamicResource GoldSoftBrush}"
            BoxShadow="0 2 8 0 #0A000000"
            Padding="{Binding BarPadding}"
            Margin="{Binding BarMargin}">
        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
        </Border.Transitions>

        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- Left: Break Icon & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border CornerRadius="6" Background="#18C29447" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}" FontSize="{Binding IconFontSize}" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}"
                           FontSize="{Binding TitleFontSize}" FontWeight="Bold"
                           Foreground="{DynamicResource BronzeBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Center: Namaaz Timings (Zawaal & Zuhr End) or Activity Note -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="•" FontSize="{Binding NoteFontSize}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NamaazNote}"
                           FontSize="{Binding NoteFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: Time Range & Duration Pill -->
            <Border Grid.Column="2"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="8,2"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding TimeRange}"
                               FontSize="{Binding TimeFontSize}" FontWeight="Bold"
                               FontFamily="Courier New, monospace"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="•" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding Duration}"
                               FontSize="{Binding TimeFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BronzeBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
