<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             xmlns:models="using:Jadwal.Domain.Models"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="165"
             x:Class="Jadwal.UI.Controls.ClassCardControl"
             x:DataType="vm:ClassCardItemViewModel">

    <Border Width="215" Height="165"
            CornerRadius="14"
            BorderThickness="1.5"
            BorderBrush="{DynamicResource CardBorderBrush}"
            Background="{DynamicResource CardBackgroundBrush}"
            BoxShadow="0 4 14 0 #12000000"
            Margin="6">
        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
        </Border.Transitions>

        <Panel>
            <!-- FRONT FACE: CLASS DETAILS -->
            <Grid RowDefinitions="Auto,*,Auto" Margin="12" IsVisible="{Binding !IsFlipped}">
                <!-- Top Row: Period, Time, Status Badge -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Border Background="{DynamicResource BronzeSoftBrush}"
                                CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding Period.PeriodName}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource BronzeBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Period.StartTime}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <!-- Live Status Pill -->
                    <Border Grid.Column="2"
                            CornerRadius="10" Padding="8,2"
                            Background="{DynamicResource EmeraldSoftBrush}">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource EmeraldBrush}" />
                    </Border>
                </Grid>

                <!-- Middle: Arabic Subject in Kanz-al-Lulu -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,4">
                    <TextBlock Text="{Binding Period.Subject}"
                               FontFamily="{StaticResource ArabicCalligraphyFont}"
                               FontSize="24" FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Period.Details}"
                               FontFamily="{StaticResource ArabicCalligraphyFont}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Bottom Row: Time End & Tasks Flip Button -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Period.EndTime, StringFormat='Ends {0}'}"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Classes="flat"
                            Padding="6,3"
                            CornerRadius="8"
                            Background="{DynamicResource BronzeSoftBrush}"
                            Click="OnFlipClicked">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📋" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TasksCountText}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource BronzeBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- BACK FACE: SUBJECT TASKS MANAGEMENT -->
            <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto" Margin="10" IsVisible="{Binding IsFlipped}">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="📋 Tasks •" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource BronzeBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Period.Subject}"
                                   FontFamily="{StaticResource ArabicCalligraphyFont}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕"
                            Classes="flat"
                            Padding="6,2" FontSize="10" FontWeight="Bold"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Click="OnFlipClicked" />
                </Grid>

                <!-- Task List (Scrollable) -->
                <ScrollViewer Grid.Row="1" Margin="0,2,0,4" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Empty State Notice -->
                        <TextBlock Text="No tasks for this subject yet."
                                   IsVisible="{Binding !Tasks.Count}"
                                   FontSize="10" FontStyle="Italic"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,16" />

                        <!-- Interactive Task Items -->
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:TaskItem">
                                    <Border Margin="0,2" Padding="6,3"
                                            Background="{DynamicResource TaskItemBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Checkbox for completion -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsCompleted}"
                                                      Command="{Binding $parent[UserControl].((vm:ClassCardItemViewModel)DataContext).ToggleTaskCompletionCommand}"
                                                      CommandParameter="{Binding}"
                                                      Padding="0" MinWidth="16" Height="16" Margin="0,0,4,0" />

                                            <!-- Task Title -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontFamily="{StaticResource ArabicCalligraphyFont}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2" Content="×"
                                                    Classes="flat" Padding="4,0" FontSize="11"
                                                    Background="Transparent" Foreground="#D9383A"
                                                    Command="{Binding $parent[UserControl].((vm:ClassCardItemViewModel)DataContext).DeleteTaskCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Quick Inline Add Task Input -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                    <TextBox Grid.Column="0"
                             Text="{Binding NewTaskTitle}"
                             PlaceholderText="Add task for this subject..."
                             FontFamily="{StaticResource ArabicCalligraphyFont}"
                             FontSize="10" Height="26" Padding="6,2"
                             CornerRadius="6"
                             KeyDown="OnNewTaskKeyDown" />
                    <Button Grid.Column="1" Content="+"
                            Command="{Binding AddTaskCommand}"
                            Background="{DynamicResource EmeraldBrush}"
                            Foreground="White" FontWeight="Bold"
                            Padding="8,2" Height="26" Margin="4,0,0,0"
                            CornerRadius="6" />
                </Grid>
            </Grid>
        </Panel>
    </Border>
</UserControl>
