<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jadwal.UI.ViewModels"
             xmlns:models="using:Jadwal.Domain.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="165"
             x:Class="Jadwal.UI.Controls.ClassCardControl"
             x:DataType="vm:ClassCardItemViewModel">

    <!-- Status glow: BorderBrush bound to StatusBorderBrush (green=live, orange=changed, muted=done, default=upcoming) -->
    <Border MinWidth="180" Height="165"
            CornerRadius="14"
            BorderThickness="2"
            BorderBrush="{Binding StatusBorderBrush}"
            Background="{Binding StatusCardBackground}"
            BoxShadow="0 4 14 0 #12000000"
            Margin="4">
        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut" />
            </Transitions>
        </Border.Transitions>

        <Panel>
            <!-- ═══════════════════════════════════════════════════════
                 FRONT FACE: CLEAN SUBJECT CARD — No pills, no clutter
            ═══════════════════════════════════════════════════════ -->
            <Grid RowDefinitions="Auto,*,Auto" Margin="12" IsVisible="{Binding !IsFlipped}">

                <!-- Top Row: Period name + time — plain text, NO pill badges -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Period.PeriodName}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StartTime12H}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Middle: Arabic Subject Name — Large, Bold, Clean -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,4">
                    <TextBlock Text="{Binding Period.Subject}"
                               FontFamily="{StaticResource ArabicCalligraphyFont}"
                               FontSize="26" FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Bottom Row: End time (plain) + subtle details flip button -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding EndTimeDisplay}"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />

                    <!-- Subtle ℹ button to flip to details — no pill wrapper -->
                    <Button Grid.Column="1"
                            Classes="flat"
                            Padding="4,2"
                            CornerRadius="8"
                            Background="Transparent"
                            Click="OnFlipClicked">
                        <TextBlock Text="ℹ"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════
                 BACK FACE: TEACHER / DETAILS (Clean — No Task List)
            ═══════════════════════════════════════════════════════ -->
            <Grid RowDefinitions="Auto,*,Auto" Margin="12" IsVisible="{Binding IsFlipped}">

                <!-- Header: Subject + Close -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Period.Subject}"
                               FontFamily="{StaticResource ArabicCalligraphyFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕"
                            Classes="flat"
                            Padding="6,2" FontSize="10" FontWeight="Bold"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Click="OnFlipClicked" />
                </Grid>

                <!-- Teacher / Details content -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">

                    <!-- Period & Time row -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🕐" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Period.PeriodName}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="·" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StartTime12H}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Teacher / Details (Arabic calligraphy) -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding Period.Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="👤" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Period.Details}"
                                   FontFamily="{StaticResource ArabicCalligraphyFont}"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Fallback if no details -->
                    <TextBlock Text="No additional details."
                               IsVisible="{Binding Period.Details, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <!-- Bottom: End time -->
                <TextBlock Grid.Row="2"
                           Text="{Binding EndTimeDisplay}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Panel>
    </Border>
</UserControl>
